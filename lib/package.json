  "bugs": {
    "url": "https://github.com/flaviostutz/codeowners-query/issues"
  },
  "homepage": "https://github.com/flaviostutz/codeowners-query#readme",
  "dependencies": {
    "commander": "^13.0.0",
    "minimatch": "^10.0.0"
  },
  "devDependencies": {
    "@stutzlab/eslint-config": "^4.3.0",
    "@tsconfig/node24": "^24.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "eslint-plugin-functional": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "^6.0.3"
  }
